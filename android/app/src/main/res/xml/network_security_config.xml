<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP غير المشفّر مسموح فقط لسيرفر XAMPP المحلي أثناء التطوير على
         الجهاز (يُستخدم عند تبديل BASE_URL في app_constants.dart لعنوان
         محلي). نطاق الإنتاج app.abaadapp.sa يعمل عبر HTTPS فقط، فأُزيل من
         هذه القائمة حتى لا يُسمح لترافيك الإنتاج بالنزول إلى HTTP. عنوان
         IP المحلي يتغيّر مع شبكة جهاز التطوير — حدّثه هنا وفي
         app_constants.dart معاً، ويجب ألا يصل إلى بناء الإنتاج. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.108.21.107</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
